<Page x:Class="Secucode.TestDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Test Details">

    <Page.Resources>
        <LinearGradientBrush x:Key="PageBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E3F2FD" Offset="0"/>
            <GradientStop Color="#BBDEFB" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="CardBackground" Color="White"/>
        <SolidColorBrush x:Key="PrimaryColor" Color="#3F51B5"/>
        <SolidColorBrush x:Key="ButtonHoverColor" Color="#303F9F"/>

        <DropShadowEffect x:Key="ShadowEffect"
                          Color="Black"
                          BlurRadius="10"
                          ShadowDepth="3"
                          Opacity="0.4"/>

        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}" />
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ButtonHoverColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource PageBackground}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Background="#AAFFFFFF" CornerRadius="20"
        Padding="40" Margin="40"
        BorderBrush="{StaticResource PrimaryColor}" BorderThickness="2"
        Effect="{StaticResource ShadowEffect}">

                <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                    <!-- Header -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <TextBlock Text="📝" FontSize="40" Margin="0,0,10,0"/>
                        <TextBlock Text="Test Details" FontSize="36" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}"/>
                    </StackPanel>

                    <!-- Test Info Grid -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Name:" FontWeight="Bold" FontSize="22" Foreground="{StaticResource PrimaryColor}" Grid.Row="0" Grid.Column="0"/>
                        <TextBlock Text="{Binding Name}" FontSize="22" Grid.Row="0" Grid.Column="1"/>

                        <TextBlock Text="Created By:" FontWeight="Bold" FontSize="22" Foreground="{StaticResource PrimaryColor}" Grid.Row="1" Grid.Column="0"/>
                        <TextBlock Text="{Binding CreatedBy}" FontSize="22" Grid.Row="1" Grid.Column="1"/>

                        <TextBlock Text="Date:" FontWeight="Bold" FontSize="22" Foreground="{StaticResource PrimaryColor}" Grid.Row="2" Grid.Column="0"/>
                        <TextBlock Text="{Binding Date}" FontSize="22" Grid.Row="2" Grid.Column="1"/>

                        <TextBlock Text="Time Limit:" FontWeight="Bold" FontSize="22" Foreground="{StaticResource PrimaryColor}" Grid.Row="3" Grid.Column="0"/>
                        <TextBlock Text="{Binding TimeLimit}" FontSize="22" Grid.Row="3" Grid.Column="1"/>

                        <TextBlock Text="Branch:" FontWeight="Bold" FontSize="22" Foreground="{StaticResource PrimaryColor}" Grid.Row="4" Grid.Column="0"/>
                        <TextBlock Text="{Binding BranchName}" FontSize="22" Grid.Row="4" Grid.Column="1"/>

                        <TextBlock Text="Class:" FontWeight="Bold" FontSize="22" Foreground="{StaticResource PrimaryColor}" Grid.Row="5" Grid.Column="0"/>
                        <TextBlock Text="{Binding ClassName}" FontSize="22" Grid.Row="5" Grid.Column="1"/>

                        <TextBlock Text="Batch:" FontWeight="Bold" FontSize="22" Foreground="{StaticResource PrimaryColor}" Grid.Row="6" Grid.Column="0"/>
                        <TextBlock Text="{Binding BatchName}" FontSize="22" Grid.Row="6" Grid.Column="1"/>
                    </Grid>

                    <!-- Divider -->
                    <Separator Margin="0,20,0,20" Height="2" Background="{StaticResource PrimaryColor}"/>

                    <!-- Questions List -->
                    <TextBlock Text="Questions:" FontWeight="Bold" FontSize="26"
                               Foreground="{StaticResource PrimaryColor}" Margin="0,0,0,10"/>

                    <ScrollViewer Height="400" VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="QuestionsListBox" ItemsSource="{Binding Questions}" 
                                 BorderThickness="1" BorderBrush="{StaticResource PrimaryColor}" 
                                 Background="White" Padding="5" Margin="0,0,0,20">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Background="#E3F2FD" Padding="20" Margin="5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔹" FontSize="18" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding}" FontSize="20" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="20">
                        <Button Name="OpenTestPageButton" Content="Take Test" Click="OpenTestPageButton_Click"
                                Style="{StaticResource RoundedButtonStyle}"/>
                        <Button Name="OpenSubmissionsFolderButton" Content="Open Submissions" Margin="20,0,0,0"
                                Click="OpenSubmissionsFolderButton_Click"
                                Style="{StaticResource RoundedButtonStyle}"/>
                        <Button Content="Back" Click="BackButton_Click" Margin="20,0,0,0"
                                Background="Red" Style="{StaticResource RoundedButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
