<!-- TestWindow.xaml -->
<Window x:Class="Secucode.TestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Take Test" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <TextBlock x:Name="lblTestName" FontSize="24" FontWeight="Bold" Margin="10"/>
            <TextBlock x:Name="lblTestDate" FontSize="18" Margin="10"/>
            <TextBlock x:Name="lblTestTimeLimit" FontSize="18" Margin="10"/>

            <ListBox x:Name="QuestionsListBox" Margin="10" Height="300"/>

            <Button Content="Submit Test" HorizontalAlignment="Center" Width="150" Click="SubmitTestButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
