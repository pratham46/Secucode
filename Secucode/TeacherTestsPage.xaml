<Page x:Class="Secucode.TeacherTestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:Secucode"
      Title="Teacher Dashboard">
    <Grid Margin="40" Background="#F5F5F5">

        <StackPanel>
            <!-- Title Section -->
            <TextBlock Text="📚 Created Exams"
                       FontSize="36" FontWeight="Bold" Foreground="#3F51B5"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- Teacher Info -->
            <Border Padding="15" CornerRadius="15" Background="White" BorderBrush="#3F51B5" BorderThickness="2" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="User: " FontWeight="Bold" FontSize="18" Foreground="#3F51B5"/>
                    <TextBlock Text="{Binding Username}" FontSize="16" Margin="5,0"/>
                    <TextBlock Text=" | Role: " FontWeight="Bold" FontSize="18" Foreground="#3F51B5"/>
                    <TextBlock Text="{Binding Role}" FontSize="16" Margin="5,0"/>
                    <TextBlock Text=" | PIN: " FontWeight="Bold" FontSize="18" Foreground="#3F51B5"/>
                    <TextBlock Text="{Binding Pin}" FontSize="16" Margin="5,0"/>
                </StackPanel>
            </Border>

            <!-- Exam List Container -->
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="TestsListBox" SelectionChanged="TestsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="10" Padding="20" Background="#E3F2FD" CornerRadius="10"
                                        BorderBrush="#3F51B5" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect ShadowDepth="0" BlurRadius="4" Opacity="0.2"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#BBDEFB"/>
                                                    <Setter Property="RenderTransform">
                                                        <Setter.Value>
                                                            <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Bold" Foreground="#1A237E"/>
                                        <TextBlock Margin="0,5,0,0" FontSize="16">
                                            <Run Text="📅 Date: " FontWeight="Bold"/>
                                            <Run Text="{Binding Date}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="16">
                                            <Run Text="⏳ Time Limit: " FontWeight="Bold"/>
                                            <Run Text="{Binding TimeLimit}"/>
                                            <Run Text=" minutes"/>
                                        </TextBlock>

                                        <!-- Buttons Row -->
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                                            <!-- Edit Button -->
                                            <Button Content="Edit" Width="70" Margin="5,0,0,0" Click="EditTestButton_Click"
            Background="#1976D2" Foreground="White" BorderBrush="#1976D2" Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#1565C0"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Delete Button -->
                                            <Button Content="Delete" Width="70" Margin="5,0,0,0" Click="DeleteTestButton_Click"
            Background="#D32F2F" Foreground="White" BorderBrush="#D32F2F" Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#B71C1C"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Toggle Active/Inactive Button -->
                                            <Button Content="{Binding IsActive, Converter={StaticResource BooleanToTextConverter}}" Width="90" Margin="5,0,0,0" Click="ToggleActiveButton_Click"
            Background="#388E3C" Foreground="White" BorderBrush="#388E3C" Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#2E7D32"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <!-- Empty List Message -->
                <TextBlock x:Name="NoTestsMessage" Text="No created exams found." FontSize="20" FontStyle="Italic"
                           Foreground="Gray" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- Create Exam Button -->
            <Button Content="➕ Create New Exam"
                    Width="180" Height="50" FontSize="18" Cursor="Hand"
                    Background="#3F51B5" Foreground="White" BorderThickness="0"
                    HorizontalAlignment="Right" Margin="20" VerticalAlignment="Bottom"
                    Click="CreateNewTestButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#3F51B5"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#303F9F"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <!-- Logout Button -->
            <Button Content="Logout"
        Width="100" Height="40" FontSize="16"
        Background="#F44336" Foreground="White" BorderBrush="#F44336" Cursor="Hand"
        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
        Click="LogoutButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D32F2F"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Page>