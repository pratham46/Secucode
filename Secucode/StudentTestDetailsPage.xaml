<Page x:Class="Secucode.StudentTestDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Test Details" Background="#F5F5F5">

    <Grid>
        <Border Background="White" CornerRadius="20" Padding="40" Margin="40"
                BorderBrush="#3F51B5" BorderThickness="2">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <TextBlock Text="Test Details" FontSize="32" FontWeight="Bold" Foreground="#3F51B5" Margin="0,0,0,20"/>

                <!-- Test Details Section -->
                <StackPanel Margin="20" HorizontalAlignment="Center">
                    <TextBlock Text="Test Name" FontWeight="Bold" FontSize="22" Foreground="#303F9F" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}" FontSize="20" Margin="0,5,0,15" HorizontalAlignment="Center"/>

                    <TextBlock Text="Date" FontWeight="Bold" FontSize="22" Foreground="#303F9F" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Date}" FontSize="20" Margin="0,5,0,15" HorizontalAlignment="Center"/>

                    <TextBlock Text="Time Limit" FontWeight="Bold" FontSize="22" Foreground="#303F9F" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TimeLimit}" FontSize="20" Margin="0,5,0,25" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Camera Preview -->
                <Border BorderThickness="1" BorderBrush="Gray" CornerRadius="10" Padding="5" Margin="0,0,0,20">
                    <Image x:Name="CameraPreview" Width="300" Height="250" Stretch="Uniform" />
                </Border>

                <!-- Buttons Section -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="30,0,0,0">
                    <Button Content="Capture Face" Width="160" Height="50" FontSize="18"
                            Background="#1976D2" Foreground="White" BorderThickness="0"
                            Cursor="Hand" Margin="0,0,20,0" Click="CaptureFace_Click"/>

                    <Button Content="Give Test" Width="160" Height="50" FontSize="18"
                            Background="#388E3C" Foreground="White" BorderThickness="0"
                            Cursor="Hand" Click="GiveTestButton_Click"/>

                    <Button Content="Close" Width="160" Height="50" FontSize="18" Margin="20,0,0,0"
                            Background="#D32F2F" Foreground="White" BorderThickness="0"
                            Cursor="Hand" Click="BackButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
