<Window x:Class="Secucode.TeacherExamFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Secucode"
        Title="Enter Examination Details" WindowState="Maximized" WindowStyle="None" Background="#F5F5F5">

    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Border Background="White" Padding="40" CornerRadius="10" Margin="50" BorderBrush="#3F51B5" BorderThickness="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Stretch" Width="Auto" Margin="10">

                    <TextBlock Text="📝 Examination Details" FontSize="30" FontWeight="Bold"
                               Foreground="#3F51B5" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                    <!-- Exam Name -->
                    <Grid Margin="0,5">
                        <TextBox Name="txtExamName" Height="50" FontSize="18" Padding="12"
                                 BorderBrush="#3F51B5" BorderThickness="1"/>
                        <Label Content="Enter exam title" FontSize="16" Foreground="Gray"
                               VerticalAlignment="Center" Margin="15,0,0,0"
                               Visibility="{Binding ElementName=txtExamName, Path=Text, Converter={StaticResource BooleanToVisibilityConverter}}"
                               IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Exam Date -->
                    <TextBlock Text="Exam Date" FontSize="18" FontWeight="Bold" Margin="10,5,0,5"/>
                    <DatePicker Name="dpExamDate" Height="50" FontSize="18" Padding="8"
                                BorderBrush="#3F51B5" BorderThickness="1"/>

                    <!-- Time Limit -->
                    <Grid Margin="10,5,0,5">
                        <TextBox Name="txtTimeLimit" Height="50" FontSize="18" Padding="12"
                                 BorderBrush="#3F51B5" BorderThickness="1"/>
                        <Label Content="e.g., 60" FontSize="16" Foreground="Gray"
                               VerticalAlignment="Center" Margin="15,0,0,0"
                               Visibility="{Binding ElementName=txtTimeLimit, Path=Text, Converter={StaticResource BooleanToVisibilityConverter}}"
                               IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Branch / Class / Batch -->
                    <TextBlock Text="Branch" FontSize="18" FontWeight="Bold" Margin="10,5,0,5"/>
                    <ComboBox Name="cbBranch" Height="50" FontSize="18" BorderBrush="#3F51B5" BorderThickness="1"/>

                    <TextBlock Text="Class" FontSize="18" FontWeight="Bold" Margin="10,5,0,5"/>
                    <ComboBox Name="cbClass" Height="50" FontSize="18" BorderBrush="#3F51B5" BorderThickness="1"/>

                    <TextBlock Text="Batch" FontSize="18" FontWeight="Bold" Margin="10,5,0,5"/>
                    <ComboBox Name="cbBatch" Height="50" FontSize="18" BorderBrush="#3F51B5" BorderThickness="1"/>

                    <!-- Questions Section -->
                    <TextBlock Text="📚 Questions" FontSize="22" FontWeight="Bold" 
                               Foreground="#3F51B5" Margin="20,20,0,10" HorizontalAlignment="Center"/>
                    <ScrollViewer Height="300" VerticalScrollBarVisibility="Auto">
                        <ItemsControl Name="questionsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" BorderBrush="#3F51B5" BorderThickness="1" Background="White" Padding="12" Margin="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="4*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="5" Grid.Column="0"/>
                                            <TextBox FontSize="18" Padding="10" MinHeight="50" BorderThickness="1"
                                                     BorderBrush="#3F51B5" Background="#FAFAFA" Grid.Column="1" HorizontalAlignment="Stretch"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Submit/Cancel Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="30">
                        <Button Name="btnSubmit" Content="✅ Submit" Click="btnSubmit_Click"
                                Background="#3F51B5" Foreground="White" Width="200" Height="50" FontSize="18" Cursor="Hand"/>
                        <Button Name="btnCancel" Content="❌ Cancel" Click="btnCancel_Click"
                                Background="#D32F2F" Foreground="White" Width="200" Height="50" FontSize="18" Cursor="Hand" Margin="15,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
