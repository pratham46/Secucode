<Window x:Class="Secucode.PinVerificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PIN Verification" Height="250" Width="350" Background="#F5F5F5" WindowStartupLocation="CenterScreen" >

    <Grid>
        <Border Background="White" CornerRadius="15" Padding="20" BorderBrush="#3F51B5" BorderThickness="2">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="PIN Verification" FontSize="22" FontWeight="Bold" Foreground="#3F51B5" TextAlignment="Center" Margin="0,0,0,15"/>
                <TextBlock Text="Enter your PIN:" FontWeight="Bold" FontSize="16" Foreground="#303F9F" Margin="0,0,0,10"/>

                <PasswordBox x:Name="PinInputBox" Width="250" Height="40" FontSize="18" Padding="5"
                        BorderBrush="#3F51B5" BorderThickness="1" Background="#E3F2FD"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="20,10,0,0">
                    <Button Content="Verify" Width="120" Height="45" FontSize="16" Background="#388E3C" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Click="VerifyButton_Click"/>
                    <Button Content="Cancel" Width="120" Height="45" FontSize="16" Background="#D32F2F" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Margin="15,0,0,0" Click="CancelButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>