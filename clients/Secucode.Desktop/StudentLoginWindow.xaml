<Window x:Class="Secucode.StudentLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Secucode"
        Title="Student Login" WindowState="Maximized" WindowStyle="None" Background="{StaticResource PrimaryBackgroundBrush}">

    <Window.DataContext>
        <local:StudentLoginViewModel/>
    </Window.DataContext>

    <Grid>
        <Border Background="{StaticResource SecondaryBackgroundBrush}" CornerRadius="20" Padding="30" Margin="50">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Student Login" FontSize="36" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- Username -->
                <Grid Width="300" Margin="0,0,0,10">
                    <TextBox Name="txtUsername" Width="300" Height="40" Padding="5" 
                             Style="{StaticResource TextBoxStyle}" Margin="0,10,0,10" />
                    <Label Content="Username" Foreground="Gray" IsHitTestVisible="False" 
                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" 
                           Visibility="{Binding ElementName=txtUsername, Path=Text, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>

                <!-- Password -->
                <Grid Width="300" Margin="0,0,0,10">
                    <PasswordBox Name="txtPassword" Width="300" Height="40" Padding="5" 
                                 Style="{StaticResource PasswordBoxStyle}" Margin="0,10,0,10" PasswordChanged="PasswordBox_PasswordChanged"/>
                    <Label Content="Password" Foreground="Gray" IsHitTestVisible="False" 
                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" 
                           Visibility="{Binding IsPasswordEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>

                <!-- Batch Name -->
                <Grid Width="300" Margin="0,0,0,10">
                    <TextBox Name="txtBatchName" Width="300" Height="40" Padding="5" 
                             Style="{StaticResource TextBoxStyle}" Margin="0,10,0,10" />
                    <Label Content="Batch Name" Foreground="Gray" IsHitTestVisible="False" 
                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" 
                           Visibility="{Binding ElementName=txtBatchName, Path=Text, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>

                <!-- Login Error Message -->
                <TextBlock x:Name="txtError" FontSize="14" Foreground="Red" Visibility="Collapsed" Text="" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10"/>

                <!-- Buttons -->
                <Button Name="btnLogin" Content="Login" Click="btnLogin_Click" Width="300" Height="40" 
                        Style="{StaticResource ButtonStyle}" Margin="0,0,0,10" IsDefault="True"/>
                <Button Name="btnBack" Content="Back" Click="btnBack_Click" Width="300" Height="40" 
                        Style="{StaticResource ButtonStyle}" IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
